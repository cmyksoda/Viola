<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.cmyksoda.viola"
    android:versionCode="10"
    android:versionName="1.0.0">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Viola"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Viola"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ViolaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The classic icon's launcher entry; the theme icons' entries are generated as Icon_<theme>. -->
        <activity-alias
            android:name=".ClassicIcon"
            android:targetActivity=".ViolaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- theme icon aliases -->
    </application>
</manifest>
